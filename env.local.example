# Copy to .env.local (not committed). Keys: Supabase → Project Settings → API.
#
# Supabase → Authentication → URL Configuration:
#   Site URL: http://localhost:3000 (or your production origin)
#   Redirect URLs (optional): /auth/callback if you add password-reset or OAuth later
#
# Admin login uses email + password (signInWithPassword). Create users under
# Authentication → Users and set a password (or send invite). Disable public
# sign-up under Providers → Email if you only want manually provisioned admins.

NEXT_PUBLIC_SUPABASE_URL=

# New dashboard name; falls back to NEXT_PUBLIC_SUPABASE_ANON_KEY if unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Legacy (still supported if publishable key is not set)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never expose to the browser. API routes insert leads with this key.
SUPABASE_SERVICE_ROLE_KEY=

# Existing
# RESEND_API_KEY=
# QUOTE_RECIPIENT_EMAIL=
